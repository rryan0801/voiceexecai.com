{
  "name": "Rep",
  "properties": {
    "client_id": {
      "description": "Which client/team this rep belongs to",
      "type": "string"
    },
    "crm_logs": {
      "default": 0,
      "type": "number"
    },
    "description": {
      "description": "Additional details or notes about this record",
      "maxLength": 1000,
      "type": "string"
    },
    "email": {
      "description": "Rep's email",
      "type": "string"
    },
    "emails_sent": {
      "default": 0,
      "type": "number"
    },
    "full_name": {
      "type": "string"
    },
    "hours_saved": {
      "default": 0,
      "description": "Estimated hours saved (calculated)",
      "type": "number"
    },
    "last_active": {
      "format": "date-time",
      "type": "string"
    },
    "meetings_booked": {
      "default": 0,
      "type": "number"
    },
    "role": {
      "default": "rep",
      "enum": [
        "rep",
        "manager",
        "admin"
      ],
      "type": "string"
    },
    "streak_days": {
      "default": 0,
      "description": "Consecutive days active",
      "type": "number"
    },
    "tasks_created": {
      "default": 0,
      "type": "number"
    },
    "total_commands": {
      "default": 0,
      "type": "number"
    },
    "user_id": {
      "description": "Base44 user id of the rep",
      "type": "string"
    },
    "whatsapp_number": {
      "description": "Rep's WhatsApp phone number (E.164 format e.g. +12125551234)",
      "type": "string"
    },
    "whatsapp_verified": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "email",
    "client_id"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}