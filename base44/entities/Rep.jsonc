{
  "name": "Rep",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Base44 user id of the rep"
    },
    "email": {
      "type": "string",
      "description": "Rep's email"
    },
    "full_name": {
      "type": "string"
    },
    "client_id": {
      "type": "string",
      "description": "Which client/team this rep belongs to"
    },
    "role": {
      "type": "string",
      "enum": [
        "rep",
        "manager",
        "admin"
      ],
      "default": "rep"
    },
    "whatsapp_number": {
      "type": "string",
      "description": "Rep's WhatsApp phone number (E.164 format e.g. +12125551234)"
    },
    "whatsapp_verified": {
      "type": "boolean",
      "default": false
    },
    "total_commands": {
      "type": "number",
      "default": 0
    },
    "emails_sent": {
      "type": "number",
      "default": 0
    },
    "meetings_booked": {
      "type": "number",
      "default": 0
    },
    "tasks_created": {
      "type": "number",
      "default": 0
    },
    "crm_logs": {
      "type": "number",
      "default": 0
    },
    "hours_saved": {
      "type": "number",
      "default": 0,
      "description": "Estimated hours saved (calculated)"
    },
    "last_active": {
      "type": "string",
      "format": "date-time"
    },
    "streak_days": {
      "type": "number",
      "default": 0,
      "description": "Consecutive days active"
    }
  },
  "required": [
    "email",
    "client_id"
  ]
}