{
  "name": "ContactRequest",
  "properties": {
    "company": {
      "description": "Company name",
      "type": "string"
    },
    "description": {
      "description": "Additional details or notes about this record",
      "maxLength": 1000,
      "type": "string"
    },
    "email": {
      "description": "Email address",
      "type": "string"
    },
    "message": {
      "description": "Message content",
      "type": "string"
    },
    "name": {
      "description": "Full name",
      "type": "string"
    },
    "status": {
      "default": "new",
      "enum": [
        "new",
        "in_progress",
        "resolved",
        "closed"
      ],
      "type": "string"
    },
    "subject": {
      "description": "Inquiry type",
      "enum": [
        "general",
        "sales",
        "support",
        "security",
        "partnership"
      ],
      "type": "string"
    },
    "submitted_at": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "name",
    "email",
    "subject",
    "message"
  ],
  "rls": {
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}