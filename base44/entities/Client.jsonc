{
  "name": "Client",
  "properties": {
    "api_key": {
      "description": "Unique API key for widget authentication",
      "type": "string"
    },
    "company_name": {
      "description": "Name of the client company",
      "type": "string"
    },
    "description": {
      "description": "Additional details or notes about this record",
      "maxLength": 1000,
      "type": "string"
    },
    "heyrichy_account_id": {
      "description": "HeyRichyAI account ID for command execution",
      "type": "string"
    },
    "monthly_quota": {
      "default": 10000,
      "description": "Monthly API call limit",
      "type": "number"
    },
    "status": {
      "default": "active",
      "enum": [
        "active",
        "suspended",
        "inactive"
      ],
      "type": "string"
    },
    "webhook_url": {
      "description": "Optional webhook URL to receive execution results",
      "type": "string"
    },
    "widget_config": {
      "description": "Widget customization settings",
      "properties": {
        "accent_color": {
          "default": "#0066FF",
          "type": "string"
        },
        "brand_logo_url": {
          "type": "string"
        },
        "enabled_tools": {
          "description": "List of tool names available to this client",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "position": {
          "default": "bottom-right",
          "enum": [
            "bottom-right",
            "bottom-left",
            "top-right",
            "top-left"
          ],
          "type": "string"
        },
        "primary_color": {
          "default": "#000000",
          "type": "string"
        },
        "secondary_color": {
          "default": "#FFFFFF",
          "type": "string"
        },
        "widget_title": {
          "default": "VoiceRep AI",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "company_name",
    "api_key",
    "heyrichy_account_id"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}