{
  "name": "ObjectionPredictor",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "company_industry_objection_pattern": {
      "description": "Common objections from this industry",
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "company_size_objection_pattern": {
      "description": "Common objections from companies this size",
      "type": "string"
    },
    "confidence_score": {
      "description": "0-100 confidence in predictions",
      "type": "number"
    },
    "description": {
      "description": "Additional details or notes about this record",
      "maxLength": 1000,
      "type": "string"
    },
    "predicted_at": {
      "format": "date-time",
      "type": "string"
    },
    "predicted_objections": {
      "description": "Top objections this prospect likely to raise",
      "items": {
        "properties": {
          "likelihood": {
            "description": "0-100 probability",
            "type": "number"
          },
          "objection": {
            "type": "string"
          },
          "reason": {
            "description": "Why we predict this",
            "type": "string"
          },
          "rebuttal": {
            "description": "Pre-written response",
            "type": "string"
          },
          "similar_closed_deals": {
            "description": "How many similar deals we overcame this on",
            "type": "number"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "prospect_id": {
      "type": "string"
    },
    "prospect_name": {
      "type": "string"
    }
  },
  "required": [
    "prospect_id",
    "client_id",
    "prospect_name",
    "company_name"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}