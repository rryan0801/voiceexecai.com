{
  "name": "OrganicTraffic",
  "properties": {
    "avg_session_duration": {
      "description": "Seconds",
      "type": "number"
    },
    "bounce_rate": {
      "description": "Percentage",
      "type": "number"
    },
    "date": {
      "format": "date",
      "type": "string"
    },
    "description": {
      "description": "Additional details or notes about this record",
      "maxLength": 1000,
      "type": "string"
    },
    "organic_sessions": {
      "type": "number"
    },
    "organic_users": {
      "type": "number"
    },
    "pageviews": {
      "type": "number"
    },
    "top_keywords": {
      "items": {
        "properties": {
          "clicks": {
            "type": "number"
          },
          "ctr": {
            "type": "number"
          },
          "impressions": {
            "type": "number"
          },
          "keyword": {
            "type": "string"
          },
          "position": {
            "type": "number"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "top_landing_pages": {
      "items": {
        "properties": {
          "sessions": {
            "type": "number"
          },
          "url": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "tracked_at": {
      "format": "date-time",
      "type": "string"
    },
    "website_id": {
      "description": "Reference to Website",
      "type": "string"
    }
  },
  "required": [
    "website_id",
    "date"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}