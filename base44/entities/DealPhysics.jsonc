{
  "name": "DealPhysics",
  "properties": {
    "acceleration_stage": {
      "description": "Current momentum stage",
      "enum": [
        "stalled",
        "slow",
        "moderate",
        "accelerating",
        "hyperdrive"
      ],
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "close_confidence": {
      "description": "0-100 confidence in prediction",
      "type": "number"
    },
    "days_at_current_velocity": {
      "type": "number"
    },
    "deal_id": {
      "description": "Reference to DealScore",
      "type": "string"
    },
    "description": {
      "description": "Additional details or notes about this record",
      "maxLength": 1000,
      "type": "string"
    },
    "friction_points": {
      "description": "What's slowing the deal down",
      "items": {
        "properties": {
          "factor": {
            "type": "string"
          },
          "impact": {
            "description": "0-100 friction score",
            "type": "number"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "last_calculated": {
      "format": "date-time",
      "type": "string"
    },
    "momentum": {
      "description": "-1 to 1, negative=decelerating, 1=accelerating",
      "type": "number"
    },
    "predicted_close_date": {
      "description": "AI-predicted close based on physics",
      "format": "date",
      "type": "string"
    },
    "projected_vs_actual_delta": {
      "description": "Days ahead/behind original estimate",
      "type": "number"
    },
    "prospect_id": {
      "type": "string"
    },
    "prospect_name": {
      "type": "string"
    },
    "velocity": {
      "description": "Activity per day (interactions/day)",
      "type": "number"
    }
  },
  "required": [
    "deal_id",
    "prospect_id",
    "client_id",
    "velocity",
    "momentum"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}