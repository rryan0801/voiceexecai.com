{
  "name": "LinkedInMessage",
  "properties": {
    "buying_signal_detected": {
      "default": false,
      "type": "boolean"
    },
    "client_id": {
      "description": "Reference to Client",
      "type": "string"
    },
    "description": {
      "description": "Additional details or notes about this record",
      "maxLength": 1000,
      "type": "string"
    },
    "engagement_score": {
      "description": "0-100 engagement from LinkedIn interaction",
      "type": "number"
    },
    "last_message_at": {
      "format": "date-time",
      "type": "string"
    },
    "last_message_from": {
      "enum": [
        "prospect",
        "rep"
      ],
      "type": "string"
    },
    "messages": {
      "description": "Conversation thread",
      "items": {
        "properties": {
          "content": {
            "type": "string"
          },
          "direction": {
            "enum": [
              "inbound",
              "outbound"
            ],
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "sent",
              "delivered",
              "read",
              "failed"
            ],
            "type": "string"
          },
          "timestamp": {
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "prospect_id": {
      "description": "Reference to Prospect",
      "type": "string"
    },
    "prospect_linkedin_url": {
      "description": "LinkedIn profile URL",
      "type": "string"
    },
    "prospect_name": {
      "type": "string"
    },
    "rep_email": {
      "description": "Sales rep email",
      "type": "string"
    },
    "status": {
      "default": "active",
      "enum": [
        "active",
        "closed",
        "archived"
      ],
      "type": "string"
    },
    "total_messages": {
      "default": 0,
      "type": "number"
    }
  },
  "required": [
    "prospect_id",
    "client_id",
    "prospect_linkedin_url"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "data.rep_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.rep_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.rep_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}