{
  "name": "LinkedInMessage",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "description": "Additional details or notes about this record",
      "maxLength": 1000
    },
    "prospect_id": {
      "type": "string",
      "description": "Reference to Prospect"
    },
    "client_id": {
      "type": "string",
      "description": "Reference to Client"
    },
    "prospect_name": {
      "type": "string"
    },
    "prospect_linkedin_url": {
      "type": "string",
      "description": "LinkedIn profile URL"
    },
    "rep_email": {
      "type": "string",
      "description": "Sales rep email"
    },
    "messages": {
      "type": "array",
      "description": "Conversation thread",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "direction": {
            "type": "string",
            "enum": [
              "inbound",
              "outbound"
            ]
          },
          "content": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "sent",
              "delivered",
              "read",
              "failed"
            ]
          }
        }
      }
    },
    "total_messages": {
      "type": "number",
      "default": 0
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_message_from": {
      "type": "string",
      "enum": [
        "prospect",
        "rep"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "closed",
        "archived"
      ],
      "default": "active"
    },
    "engagement_score": {
      "type": "number",
      "description": "0-100 engagement from LinkedIn interaction"
    },
    "buying_signal_detected": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "prospect_id",
    "client_id",
    "prospect_linkedin_url"
  ]
}