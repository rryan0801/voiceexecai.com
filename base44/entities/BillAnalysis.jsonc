{
  "name": "BillAnalysis",
  "properties": {
    "analysis_details": {
      "description": "Full AI analysis text",
      "type": "string"
    },
    "analysis_status": {
      "default": "pending",
      "enum": [
        "pending",
        "analyzing",
        "complete",
        "error"
      ],
      "type": "string"
    },
    "analyzed_at": {
      "format": "date-time",
      "type": "string"
    },
    "bills_detected": {
      "description": "List of detected bills/subscriptions",
      "items": {
        "properties": {
          "category": {
            "type": "string"
          },
          "issue": {
            "description": "overcharge, forgotten_trial, price_hike, duplicate, etc",
            "type": "string"
          },
          "monthly_cost": {
            "type": "number"
          },
          "service": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "description": {
      "description": "Additional details or notes about this record",
      "maxLength": 1000,
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "file_url": {
      "description": "Uploaded bill/receipt file",
      "type": "string"
    },
    "leaks_found": {
      "description": "Money leak items",
      "items": {
        "properties": {
          "action": {
            "type": "string"
          },
          "leak_type": {
            "type": "string"
          },
          "potential_monthly_savings": {
            "type": "number"
          },
          "potential_yearly_savings": {
            "type": "number"
          },
          "service": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "money_leak_score": {
      "description": "0-100 score of how much money is leaking",
      "type": "number"
    },
    "total_monthly_savings": {
      "description": "Total potential monthly savings",
      "type": "number"
    },
    "total_yearly_savings": {
      "description": "Total potential yearly savings",
      "type": "number"
    },
    "user_email": {
      "description": "Email of user who uploaded",
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "file_url"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}