{
  "name": "ContentOpportunity",
  "properties": {
    "ai_generated_content": {
      "description": "Full AI-written article",
      "type": "string"
    },
    "content_brief": {
      "properties": {
        "external_references": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "internal_links": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "key_points": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "meta_description": {
          "type": "string"
        },
        "outline": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "suggested_title": {
          "type": "string"
        },
        "word_count": {
          "type": "number"
        }
      },
      "type": "object"
    },
    "content_type": {
      "enum": [
        "blog_post",
        "guide",
        "comparison",
        "listicle",
        "case_study",
        "landing_page",
        "product_page"
      ],
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "description": {
      "description": "Additional details or notes about this record",
      "maxLength": 1000,
      "type": "string"
    },
    "difficulty": {
      "description": "0-100 competition level",
      "type": "number"
    },
    "estimated_traffic_potential": {
      "description": "Estimated monthly traffic if ranking #1",
      "type": "number"
    },
    "intent": {
      "enum": [
        "informational",
        "commercial",
        "transactional",
        "navigational"
      ],
      "type": "string"
    },
    "priority_score": {
      "description": "0-100 priority to create this content",
      "type": "number"
    },
    "search_volume": {
      "description": "Total monthly searches",
      "type": "number"
    },
    "status": {
      "default": "identified",
      "enum": [
        "identified",
        "brief_ready",
        "content_created",
        "published",
        "ranking"
      ],
      "type": "string"
    },
    "target_keywords": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "topic": {
      "description": "Content topic/title",
      "type": "string"
    },
    "website_id": {
      "description": "Reference to Website",
      "type": "string"
    }
  },
  "required": [
    "website_id",
    "topic",
    "search_volume"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}