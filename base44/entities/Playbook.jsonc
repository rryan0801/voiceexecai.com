{
  "name": "Playbook",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "deal_stage": {
      "description": "Deal stage this playbook targets",
      "enum": [
        "prospecting",
        "qualification",
        "proposal",
        "negotiation",
        "closing"
      ],
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "industry": {
      "description": "Target industry (optional)",
      "type": "string"
    },
    "manager_email": {
      "description": "Manager who created this playbook",
      "type": "string"
    },
    "name": {
      "description": "Playbook name (e.g., 'Q2 Enterprise Close')",
      "type": "string"
    },
    "steps": {
      "description": "Sequence of actions",
      "items": {
        "properties": {
          "action": {
            "enum": [
              "send_email",
              "schedule_call",
              "send_proposal",
              "log_note"
            ],
            "type": "string"
          },
          "content_template": {
            "type": "string"
          },
          "delay_days": {
            "type": "number"
          },
          "description": {
            "type": "string"
          },
          "step_number": {
            "type": "number"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "success_rate": {
      "description": "% of deals using this playbook that closed",
      "type": "number"
    },
    "usage_count": {
      "default": 0,
      "type": "number"
    }
  },
  "required": [
    "client_id",
    "manager_email",
    "name",
    "steps"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "data.manager_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.manager_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.manager_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}