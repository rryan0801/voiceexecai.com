{
  "name": "DealScore",
  "properties": {
    "autopilot_progress": {
      "default": 0,
      "description": "% of AutoPilot sequence completed",
      "type": "number"
    },
    "calculated_at": {
      "description": "When score was last calculated",
      "format": "date-time",
      "type": "string"
    },
    "client_id": {
      "description": "Reference to Client",
      "type": "string"
    },
    "company_name": {
      "description": "Company name",
      "type": "string"
    },
    "description": {
      "description": "Additional details or notes about this record",
      "maxLength": 1000,
      "type": "string"
    },
    "interaction_count": {
      "default": 0,
      "description": "Total interactions",
      "type": "number"
    },
    "last_interaction_date": {
      "description": "When was the last interaction",
      "format": "date-time",
      "type": "string"
    },
    "prospect_id": {
      "description": "Reference to Prospect",
      "type": "string"
    },
    "prospect_name": {
      "description": "Prospect name for easy reference",
      "type": "string"
    },
    "recency_boost": {
      "default": 0,
      "description": "Boost from recent activity (last 7 days)",
      "type": "number"
    },
    "recommended_action": {
      "description": "Next recommended action",
      "enum": [
        "send_email",
        "schedule_call",
        "send_proposal",
        "check_in",
        "nurture"
      ],
      "type": "string"
    },
    "reply_detected": {
      "default": false,
      "description": "Has prospect replied",
      "type": "boolean"
    },
    "score_factors": {
      "description": "Breakdown of score calculation",
      "properties": {
        "autopilot_score": {
          "type": "number"
        },
        "engagement_score": {
          "type": "number"
        },
        "interaction_score": {
          "type": "number"
        },
        "recency_score": {
          "type": "number"
        }
      },
      "type": "object"
    },
    "win_probability": {
      "description": "0-100 score",
      "type": "number"
    }
  },
  "required": [
    "prospect_id",
    "client_id",
    "win_probability"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}