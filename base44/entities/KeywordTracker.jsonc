{
  "name": "KeywordTracker",
  "properties": {
    "cpc": {
      "description": "Cost per click",
      "type": "number"
    },
    "current_rank": {
      "description": "Current Google position",
      "type": "number"
    },
    "description": {
      "description": "Additional details or notes about this record",
      "maxLength": 1000,
      "type": "string"
    },
    "difficulty": {
      "description": "0-100 competition level",
      "type": "number"
    },
    "intent": {
      "enum": [
        "informational",
        "commercial",
        "navigational",
        "transactional"
      ],
      "type": "string"
    },
    "keyword": {
      "type": "string"
    },
    "last_checked": {
      "format": "date-time",
      "type": "string"
    },
    "opportunity_score": {
      "description": "0-100 priority to target",
      "type": "number"
    },
    "previous_rank": {
      "type": "number"
    },
    "rank_change": {
      "description": "Position change",
      "type": "number"
    },
    "search_volume": {
      "description": "Monthly searches",
      "type": "number"
    },
    "tracked_since": {
      "format": "date-time",
      "type": "string"
    },
    "url_ranking": {
      "description": "Which page ranks for this keyword",
      "type": "string"
    },
    "website_id": {
      "description": "Reference to Website",
      "type": "string"
    }
  },
  "required": [
    "website_id",
    "keyword"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}