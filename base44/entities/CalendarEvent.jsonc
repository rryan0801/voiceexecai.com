{
  "name": "CalendarEvent",
  "properties": {
    "attendees": {
      "items": {
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "response": {
            "enum": [
              "accepted",
              "declined",
              "tentative"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "client_id": {
      "description": "Reference to Client",
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "deal_stage_after": {
      "description": "Deal stage after meeting",
      "type": "string"
    },
    "deal_stage_before": {
      "description": "Deal stage before meeting",
      "type": "string"
    },
    "duration_minutes": {
      "type": "number"
    },
    "ended_at": {
      "format": "date-time",
      "type": "string"
    },
    "event_title": {
      "type": "string"
    },
    "event_type": {
      "description": "Type of meeting",
      "enum": [
        "discovery",
        "demo",
        "proposal",
        "negotiation",
        "close",
        "check_in",
        "other"
      ],
      "type": "string"
    },
    "next_steps": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "notes": {
      "description": "Meeting notes/summary",
      "type": "string"
    },
    "outcome": {
      "description": "Meeting outcome",
      "enum": [
        "completed",
        "no_show",
        "rescheduled",
        "cancelled"
      ],
      "type": "string"
    },
    "outlook_event_id": {
      "description": "Outlook calendar event ID",
      "type": "string"
    },
    "prospect_id": {
      "description": "Reference to Prospect",
      "type": "string"
    },
    "prospect_name": {
      "type": "string"
    },
    "rep_email": {
      "description": "Sales rep email",
      "type": "string"
    },
    "sentiment": {
      "enum": [
        "positive",
        "neutral",
        "negative"
      ],
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "event_title",
    "started_at"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "data.rep_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.rep_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.rep_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}