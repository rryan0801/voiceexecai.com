{
  "name": "ProspectReadinessPulse",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "description": {
      "description": "Additional details or notes about this record",
      "maxLength": 1000,
      "type": "string"
    },
    "hours_to_peak": {
      "description": "Estimated hours until peak readiness",
      "type": "number"
    },
    "indicators": {
      "description": "20+ signals contributing to readiness",
      "items": {
        "properties": {
          "current_value": {
            "type": "string"
          },
          "indicator": {
            "type": "string"
          },
          "status": {
            "enum": [
              "positive",
              "neutral",
              "negative"
            ],
            "type": "string"
          },
          "weight": {
            "description": "How much it impacts score",
            "type": "number"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "last_spike": {
      "description": "When was last readiness spike",
      "format": "date-time",
      "type": "string"
    },
    "prospect_id": {
      "type": "string"
    },
    "prospect_name": {
      "type": "string"
    },
    "pulse_status": {
      "description": "Current pulse trend",
      "enum": [
        "flatline",
        "rising",
        "peak",
        "critical",
        "declining"
      ],
      "type": "string"
    },
    "readiness_score": {
      "description": "0-100 are they ready to buy NOW",
      "type": "number"
    },
    "recommended_action": {
      "description": "What to do based on pulse",
      "enum": [
        "wait",
        "nurture",
        "engage",
        "close_now",
        "escalate"
      ],
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "prospect_id",
    "client_id",
    "prospect_name",
    "readiness_score"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}