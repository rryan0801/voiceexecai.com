{
  "name": "EmailTemplate",
  "properties": {
    "body": {
      "description": "Full email with personalization placeholders",
      "type": "string"
    },
    "click_rate": {
      "type": "number"
    },
    "client_id": {
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "type": "string"
    },
    "inspired_by_rep_dna": {
      "description": "Winning phrases used",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "open_rate": {
      "type": "number"
    },
    "personalization_factors": {
      "description": "What made this unique",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "prospect_id": {
      "type": "string"
    },
    "prospect_name": {
      "type": "string"
    },
    "rep_email": {
      "type": "string"
    },
    "sent": {
      "default": false,
      "type": "boolean"
    },
    "subject": {
      "type": "string"
    },
    "template_type": {
      "enum": [
        "initial_outreach",
        "follow_up",
        "objection_response",
        "proposal",
        "check_in",
        "closing"
      ],
      "type": "string"
    },
    "tone": {
      "description": "Matches rep DNA signature",
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "rep_email",
    "prospect_id",
    "template_type",
    "subject",
    "body"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "data.rep_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.rep_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.rep_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}