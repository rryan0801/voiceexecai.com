{
  "name": "Command",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "description": "Additional details or notes about this record",
      "maxLength": 1000
    },
    "client_id": {
      "type": "string",
      "description": "Reference to Client entity"
    },
    "audio_url": {
      "type": "string",
      "description": "URL of uploaded audio file"
    },
    "transcription": {
      "type": "string",
      "description": "Transcribed text from audio"
    },
    "context": {
      "type": "object",
      "description": "User-provided context (prospect_name, company, system_type, etc.)",
      "properties": {
        "prospect_name": {
          "type": "string"
        },
        "prospect_company": {
          "type": "string"
        },
        "system_type": {
          "type": "string",
          "enum": [
            "email",
            "crm",
            "document",
            "communication",
            "task",
            "other"
          ]
        },
        "additional_context": {
          "type": "string"
        }
      }
    },
    "claude_reasoning": {
      "type": "string",
      "description": "Claude's step-by-step reasoning (streamed live)"
    },
    "detected_intent": {
      "type": "string",
      "description": "What Claude determined to do"
    },
    "execution_result": {
      "type": "object",
      "description": "Result of action execution"
    },
    "streaming_output": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "transcription_chunk",
              "reasoning_chunk",
              "execution_start",
              "execution_complete",
              "error"
            ]
          },
          "content": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Real-time streaming events for live UI updates"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "transcribing",
        "reasoning",
        "executing",
        "completed",
        "failed"
      ],
      "default": "pending"
    },
    "error_message": {
      "type": "string",
      "description": "Error details if status is failed"
    },
    "processing_time_ms": {
      "type": "number",
      "description": "Total time to process command in milliseconds"
    }
  },
  "required": [
    "client_id",
    "audio_url"
  ]
}