{
  "name": "Command",
  "properties": {
    "audio_url": {
      "description": "URL of uploaded audio file",
      "type": "string"
    },
    "claude_reasoning": {
      "description": "Claude's step-by-step reasoning (streamed live)",
      "type": "string"
    },
    "client_id": {
      "description": "Reference to Client entity",
      "type": "string"
    },
    "context": {
      "description": "User-provided context (prospect_name, company, system_type, etc.)",
      "properties": {
        "additional_context": {
          "type": "string"
        },
        "prospect_company": {
          "type": "string"
        },
        "prospect_name": {
          "type": "string"
        },
        "system_type": {
          "enum": [
            "email",
            "crm",
            "document",
            "communication",
            "task",
            "other"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "description": {
      "description": "Additional details or notes about this record",
      "maxLength": 1000,
      "type": "string"
    },
    "detected_intent": {
      "description": "What Claude determined to do",
      "type": "string"
    },
    "error_message": {
      "description": "Error details if status is failed",
      "type": "string"
    },
    "execution_result": {
      "description": "Result of action execution",
      "type": "object"
    },
    "processing_time_ms": {
      "description": "Total time to process command in milliseconds",
      "type": "number"
    },
    "status": {
      "default": "pending",
      "enum": [
        "pending",
        "transcribing",
        "reasoning",
        "executing",
        "completed",
        "failed"
      ],
      "type": "string"
    },
    "streaming_output": {
      "description": "Real-time streaming events for live UI updates",
      "items": {
        "properties": {
          "content": {
            "type": "string"
          },
          "timestamp": {
            "format": "date-time",
            "type": "string"
          },
          "type": {
            "enum": [
              "transcription_chunk",
              "reasoning_chunk",
              "execution_start",
              "execution_complete",
              "error"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "transcription": {
      "description": "Transcribed text from audio",
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "audio_url"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}