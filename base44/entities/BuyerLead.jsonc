{
  "name": "BuyerLead",
  "properties": {
    "city": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "email": {
      "description": "Email address",
      "type": "string"
    },
    "followup1_sent": {
      "default": false,
      "type": "boolean"
    },
    "followup2_sent": {
      "default": false,
      "type": "boolean"
    },
    "name": {
      "description": "Full name",
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "phone": {
      "description": "Phone number",
      "type": "string"
    },
    "source": {
      "default": "landing_page",
      "type": "string"
    },
    "stage": {
      "default": "new",
      "enum": [
        "new",
        "contacted",
        "nurturing",
        "converted",
        "lost"
      ],
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "submitted_at": {
      "format": "date-time",
      "type": "string"
    },
    "vertical": {
      "description": "Service vertical",
      "enum": [
        "roofing",
        "plumbing",
        "hvac",
        "electrical",
        "landscaping",
        "cleaning",
        "painting",
        "general_contractor",
        "pest_control",
        "solar",
        "other"
      ],
      "type": "string"
    },
    "welcome_sent": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "name",
    "email",
    "phone",
    "vertical",
    "city",
    "state"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}