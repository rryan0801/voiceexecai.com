{
  "name": "Alert",
  "properties": {
    "description": {
      "description": "Alert description",
      "type": "string"
    },
    "is_read": {
      "default": false,
      "type": "boolean"
    },
    "related_review_id": {
      "description": "ID of related review if applicable",
      "type": "string"
    },
    "severity": {
      "default": "medium",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "type": "string"
    },
    "title": {
      "description": "Alert title",
      "type": "string"
    },
    "type": {
      "description": "Type of alert",
      "enum": [
        "negative_review",
        "rating_drop",
        "mention",
        "milestone"
      ],
      "type": "string"
    }
  },
  "required": [
    "title",
    "type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}