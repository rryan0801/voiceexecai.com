{
  "name": "LinkedInSignal",
  "properties": {
    "action_taken": {
      "description": "What action was taken (connect, message, etc)",
      "type": "string"
    },
    "buying_intent_score": {
      "description": "0-100 buying intent indicator",
      "type": "number"
    },
    "client_id": {
      "description": "Reference to Client",
      "type": "string"
    },
    "description": {
      "description": "Additional details or notes about this record",
      "maxLength": 1000,
      "type": "string"
    },
    "linkedin_url": {
      "description": "LinkedIn profile URL",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "description": "Additional signal data",
      "type": "object"
    },
    "occurred_at": {
      "description": "When signal occurred",
      "format": "date-time",
      "type": "string"
    },
    "prospect_id": {
      "description": "Reference to Prospect",
      "type": "string"
    },
    "prospect_name": {
      "type": "string"
    },
    "signal_detail": {
      "description": "Details about the signal",
      "type": "string"
    },
    "signal_strength": {
      "description": "How strong is this buying signal",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "type": "string"
    },
    "signal_type": {
      "description": "Type of LinkedIn signal",
      "enum": [
        "profile_view",
        "connection_request",
        "message",
        "job_change",
        "company_growth",
        "content_engagement",
        "headline_change",
        "endorsement"
      ],
      "type": "string"
    }
  },
  "required": [
    "prospect_id",
    "client_id",
    "signal_type",
    "linkedin_url"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}