{
  "name": "EmailTrackingEvent",
  "properties": {
    "click_count": {
      "default": 0,
      "description": "Total link clicks",
      "type": "number"
    },
    "client_id": {
      "description": "Reference to Client",
      "type": "string"
    },
    "description": {
      "description": "Additional details or notes about this record",
      "maxLength": 1000,
      "type": "string"
    },
    "email_id": {
      "description": "Unique email identifier",
      "type": "string"
    },
    "engagement_score": {
      "description": "0-100 engagement rating",
      "type": "number"
    },
    "first_click_at": {
      "description": "First click timestamp",
      "format": "date-time",
      "type": "string"
    },
    "first_open_at": {
      "description": "First open timestamp",
      "format": "date-time",
      "type": "string"
    },
    "last_open_at": {
      "description": "Most recent open",
      "format": "date-time",
      "type": "string"
    },
    "links_clicked": {
      "description": "Links clicked in email",
      "items": {
        "properties": {
          "click_count": {
            "type": "number"
          },
          "first_click": {
            "format": "date-time",
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "open_count": {
      "default": 0,
      "description": "Number of times opened",
      "type": "number"
    },
    "prospect_email": {
      "description": "Email address tracked",
      "type": "string"
    },
    "prospect_id": {
      "description": "Reference to Prospect",
      "type": "string"
    },
    "sent_at": {
      "description": "When email was sent",
      "format": "date-time",
      "type": "string"
    },
    "sent_by": {
      "description": "Sender email/name",
      "type": "string"
    },
    "status": {
      "description": "Email status",
      "enum": [
        "sent",
        "opened",
        "clicked",
        "replied",
        "bounced"
      ],
      "type": "string"
    },
    "subject": {
      "description": "Email subject line",
      "type": "string"
    }
  },
  "required": [
    "prospect_id",
    "client_id",
    "email_id",
    "prospect_email",
    "subject"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}