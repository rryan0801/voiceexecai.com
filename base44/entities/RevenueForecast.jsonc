{
  "name": "RevenueForecast",
  "properties": {
    "base_pipeline_value": {
      "description": "Total pipeline value",
      "type": "number"
    },
    "client_id": {
      "type": "string"
    },
    "confidence_level": {
      "description": "0-100%",
      "type": "number"
    },
    "conservative_forecast": {
      "description": "25th percentile",
      "type": "number"
    },
    "deals_included": {
      "type": "number"
    },
    "description": {
      "description": "Additional details or notes about this record",
      "maxLength": 1000,
      "type": "string"
    },
    "forecast_period": {
      "default": "quarterly",
      "enum": [
        "quarterly",
        "annual"
      ],
      "type": "string"
    },
    "historical_accuracy": {
      "description": "vs actual last period",
      "type": "number"
    },
    "key_deals": {
      "items": {
        "properties": {
          "probability": {
            "type": "number"
          },
          "prospect": {
            "type": "string"
          },
          "value": {
            "type": "number"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "optimistic_forecast": {
      "description": "75th percentile",
      "type": "number"
    },
    "predicted_at": {
      "format": "date-time",
      "type": "string"
    },
    "quarter_year": {
      "description": "Q2-2026 format",
      "type": "string"
    },
    "weighted_expected_revenue": {
      "description": "Sum of deal_value \u00d7 win_probability",
      "type": "number"
    }
  },
  "required": [
    "client_id",
    "forecast_period",
    "quarter_year"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}