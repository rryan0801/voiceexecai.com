{
  "name": "SEOAudit",
  "properties": {
    "audited_at": {
      "format": "date-time",
      "type": "string"
    },
    "content_score": {
      "description": "Content optimization score 0-100",
      "type": "number"
    },
    "description": {
      "description": "Additional details or notes about this record",
      "maxLength": 1000,
      "type": "string"
    },
    "issues": {
      "items": {
        "properties": {
          "auto_fixable": {
            "type": "boolean"
          },
          "category": {
            "enum": [
              "technical",
              "content",
              "on_page",
              "performance"
            ],
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "fix_suggestion": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "enum": [
              "critical",
              "warning",
              "info"
            ],
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "on_page_score": {
      "description": "On-page SEO score 0-100",
      "type": "number"
    },
    "overall_score": {
      "description": "0-100 SEO health score",
      "type": "number"
    },
    "pages_analyzed": {
      "type": "number"
    },
    "recommendations": {
      "description": "Priority action items",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "technical_score": {
      "description": "Technical SEO score 0-100",
      "type": "number"
    },
    "website_id": {
      "description": "Reference to Website",
      "type": "string"
    }
  },
  "required": [
    "website_id",
    "overall_score"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}