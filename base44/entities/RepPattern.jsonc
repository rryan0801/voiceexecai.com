{
  "name": "RepPattern",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "description": {
      "description": "Additional details or notes about this record",
      "maxLength": 1000,
      "type": "string"
    },
    "frequency": {
      "description": "How many times this pattern appeared",
      "type": "number"
    },
    "pattern_type": {
      "description": "Type of pattern detected",
      "enum": [
        "closing_phrase",
        "opening_approach",
        "objection_response",
        "tone",
        "success_keyword"
      ],
      "type": "string"
    },
    "pattern_value": {
      "description": "The actual pattern (e.g., 'ROI' or 'Let me ask you...')",
      "type": "string"
    },
    "recommendation": {
      "description": "Coaching tip for the rep",
      "type": "string"
    },
    "rep_email": {
      "description": "Rep's email address",
      "type": "string"
    },
    "sample_deals": {
      "items": {
        "properties": {
          "outcome": {
            "enum": [
              "won",
              "lost"
            ],
            "type": "string"
          },
          "prospect_name": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "success_rate": {
      "description": "Percentage of deals with this pattern that closed",
      "type": "number"
    }
  },
  "required": [
    "rep_email",
    "client_id",
    "pattern_type",
    "pattern_value"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "data.rep_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.rep_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.rep_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}