{
  "name": "CompetitorAnalysis",
  "properties": {
    "analyzed_at": {
      "format": "date-time",
      "type": "string"
    },
    "backlinks_count": {
      "description": "Total inbound links",
      "type": "number"
    },
    "competitor_name": {
      "type": "string"
    },
    "competitor_url": {
      "description": "Competitor website URL",
      "type": "string"
    },
    "content_gaps": {
      "description": "Keywords they rank for but we don't",
      "items": {
        "properties": {
          "keyword": {
            "type": "string"
          },
          "opportunity_score": {
            "type": "number"
          },
          "our_position": {
            "type": "number"
          },
          "recommended_action": {
            "type": "string"
          },
          "their_position": {
            "type": "number"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "description": {
      "description": "Additional details or notes about this record",
      "maxLength": 1000,
      "type": "string"
    },
    "domain_authority": {
      "description": "0-100 domain strength",
      "type": "number"
    },
    "estimated_monthly_traffic": {
      "description": "Estimated organic traffic",
      "type": "number"
    },
    "top_keywords": {
      "items": {
        "properties": {
          "keyword": {
            "type": "string"
          },
          "position": {
            "type": "number"
          },
          "search_volume": {
            "type": "number"
          },
          "url": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "top_referring_domains": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "total_keywords": {
      "description": "Keywords they rank for",
      "type": "number"
    },
    "website_id": {
      "description": "Reference to Website",
      "type": "string"
    }
  },
  "required": [
    "website_id",
    "competitor_url"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}