{
  "name": "DealRoom",
  "properties": {
    "action_items": {
      "items": {
        "properties": {
          "due": {
            "format": "date",
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "task": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "client_id": {
      "type": "string"
    },
    "collaborators": {
      "description": "Team member emails",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "deal_id": {
      "type": "string"
    },
    "key_contacts": {
      "items": {
        "properties": {
          "engagement_level": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "notes": {
      "items": {
        "properties": {
          "author": {
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "owner_email": {
      "description": "Account owner/rep",
      "type": "string"
    },
    "prospect_id": {
      "type": "string"
    },
    "prospect_name": {
      "type": "string"
    },
    "room_name": {
      "type": "string"
    },
    "strategy": {
      "description": "Agreed deal strategy",
      "type": "string"
    },
    "timeline": {
      "properties": {
        "current_stage": {
          "type": "string"
        },
        "estimated_days_to_close": {
          "type": "number"
        },
        "target_close": {
          "format": "date",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "deal_id",
    "prospect_id",
    "client_id",
    "prospect_name",
    "owner_email"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}