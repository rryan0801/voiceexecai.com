{
  "name": "CRMWebhookAdapter",
  "properties": {
    "adapter_name": {
      "description": "Custom name for this CRM adapter (e.g., 'Custom Salesforce v2')",
      "type": "string"
    },
    "api_endpoint": {
      "description": "CRM API base URL for push updates",
      "type": "string"
    },
    "api_key": {
      "description": "API key for authenticating outbound requests",
      "type": "string"
    },
    "client_id": {
      "description": "Reference to Client",
      "type": "string"
    },
    "crm_type": {
      "description": "CRM system name (e.g., 'custom', 'salesforce', 'dynamics365')",
      "type": "string"
    },
    "description": {
      "description": "Additional details or notes about this record",
      "maxLength": 1000,
      "type": "string"
    },
    "events_processed": {
      "default": 0,
      "description": "Total webhooks successfully processed",
      "type": "number"
    },
    "events_received": {
      "default": 0,
      "description": "Total webhooks received",
      "type": "number"
    },
    "field_mapping": {
      "description": "Maps CRM fields to VoiceExec fields",
      "properties": {
        "company_field": {
          "type": "string"
        },
        "custom_fields": {
          "additionalProperties": true,
          "type": "object"
        },
        "deal_stage_field": {
          "type": "string"
        },
        "deal_value_field": {
          "type": "string"
        },
        "email_field": {
          "type": "string"
        },
        "phone_field": {
          "type": "string"
        },
        "prospect_name_field": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "last_sync": {
      "description": "Last successful sync timestamp",
      "format": "date-time",
      "type": "string"
    },
    "status": {
      "default": "active",
      "enum": [
        "active",
        "inactive",
        "error"
      ],
      "type": "string"
    },
    "sync_direction": {
      "description": "Direction of data sync",
      "enum": [
        "inbound",
        "outbound",
        "bidirectional"
      ],
      "type": "string"
    },
    "sync_error": {
      "description": "Error message if last sync failed",
      "type": "string"
    },
    "sync_frequency": {
      "default": "real-time",
      "description": "How often to sync",
      "enum": [
        "real-time",
        "hourly",
        "daily"
      ],
      "type": "string"
    },
    "webhook_secret": {
      "description": "Secret key for webhook verification",
      "type": "string"
    },
    "webhook_url": {
      "description": "Incoming webhook URL from the external CRM",
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "adapter_name",
    "crm_type",
    "webhook_url",
    "field_mapping"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}