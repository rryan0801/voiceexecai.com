{
  "name": "Task",
  "properties": {
    "assigned_to": {
      "description": "Email of the person assigned",
      "type": "string"
    },
    "client_id": {
      "description": "Reference to Client entity",
      "type": "string"
    },
    "command_id": {
      "description": "Reference to Command entity that created this task",
      "type": "string"
    },
    "description": {
      "description": "Task details",
      "type": "string"
    },
    "due_date": {
      "description": "When the task is due",
      "format": "date-time",
      "type": "string"
    },
    "priority": {
      "default": "medium",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "type": "string"
    },
    "prospect_id": {
      "description": "Reference to Prospect entity",
      "type": "string"
    },
    "status": {
      "default": "pending",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "type": "string"
    },
    "title": {
      "description": "Task title",
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "title"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.assigned_to": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.assigned_to": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}