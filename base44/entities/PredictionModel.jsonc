{
  "name": "PredictionModel",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "confidence_score": {
      "description": "0-1 confidence in prediction",
      "type": "number"
    },
    "deal_id": {
      "description": "Reference to DealScore entity",
      "type": "string"
    },
    "description": {
      "description": "Additional details or notes about this record",
      "maxLength": 1000,
      "type": "string"
    },
    "key_drivers": {
      "description": "Top factors affecting prediction",
      "items": {
        "properties": {
          "evidence": {
            "type": "string"
          },
          "factor": {
            "type": "string"
          },
          "impact": {
            "description": "Positive or negative impact on win probability",
            "type": "number"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "next_best_action": {
      "description": "Recommended action to increase win probability",
      "type": "string"
    },
    "predicted_at": {
      "format": "date-time",
      "type": "string"
    },
    "prospect_id": {
      "type": "string"
    },
    "prospect_name": {
      "type": "string"
    },
    "recommended_timeline": {
      "description": "Expected close date based on signals",
      "type": "string"
    },
    "risk_factors": {
      "description": "Identified risks to close",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "similar_won_deals": {
      "description": "Similar deals that won in the past",
      "items": {
        "properties": {
          "prospect_name": {
            "type": "string"
          },
          "similarity_score": {
            "type": "number"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "win_prediction": {
      "description": "0-100 probability of winning",
      "type": "number"
    }
  },
  "required": [
    "deal_id",
    "prospect_id",
    "client_id",
    "win_prediction"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}