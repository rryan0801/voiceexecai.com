{
  "name": "PredictionModel",
  "type": "object",
  "properties": {
    "deal_id": {
      "type": "string",
      "description": "Reference to DealScore entity"
    },
    "prospect_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "prospect_name": {
      "type": "string"
    },
    "win_prediction": {
      "type": "number",
      "description": "0-100 probability of winning"
    },
    "confidence_score": {
      "type": "number",
      "description": "0-1 confidence in prediction"
    },
    "key_drivers": {
      "type": "array",
      "description": "Top factors affecting prediction",
      "items": {
        "type": "object",
        "properties": {
          "factor": {
            "type": "string"
          },
          "impact": {
            "type": "number",
            "description": "Positive or negative impact on win probability"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "risk_factors": {
      "type": "array",
      "description": "Identified risks to close",
      "items": {
        "type": "string"
      }
    },
    "next_best_action": {
      "type": "string",
      "description": "Recommended action to increase win probability"
    },
    "recommended_timeline": {
      "type": "string",
      "description": "Expected close date based on signals"
    },
    "similar_won_deals": {
      "type": "array",
      "description": "Similar deals that won in the past",
      "items": {
        "type": "object",
        "properties": {
          "prospect_name": {
            "type": "string"
          },
          "similarity_score": {
            "type": "number"
          }
        }
      }
    },
    "predicted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "deal_id",
    "prospect_id",
    "client_id",
    "win_prediction"
  ]
}