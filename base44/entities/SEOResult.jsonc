{
  "name": "SEOResult",
  "properties": {
    "achieved_at": {
      "format": "date-time",
      "type": "string"
    },
    "after_value": {
      "type": "number"
    },
    "before_value": {
      "type": "number"
    },
    "description": {
      "description": "What was achieved",
      "type": "string"
    },
    "estimated_revenue_impact": {
      "description": "Estimated monthly revenue increase",
      "type": "number"
    },
    "impact": {
      "description": "Business impact level",
      "enum": [
        "low",
        "medium",
        "high",
        "massive"
      ],
      "type": "string"
    },
    "improvement_percentage": {
      "type": "number"
    },
    "metric_type": {
      "enum": [
        "traffic_increase",
        "ranking_improvement",
        "keyword_gained",
        "issue_fixed",
        "competitor_overtaken"
      ],
      "type": "string"
    },
    "title": {
      "description": "Achievement title",
      "type": "string"
    },
    "website_id": {
      "description": "Reference to Website",
      "type": "string"
    }
  },
  "required": [
    "website_id",
    "metric_type",
    "title",
    "description"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}