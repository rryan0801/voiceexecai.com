{
  "name": "CoachingFeedback",
  "properties": {
    "acted_upon": {
      "default": false,
      "type": "boolean"
    },
    "client_id": {
      "type": "string"
    },
    "delivered_at": {
      "format": "date-time",
      "type": "string"
    },
    "description": {
      "description": "Additional details or notes about this record",
      "maxLength": 1000,
      "type": "string"
    },
    "effectiveness": {
      "description": "1-5 rating of coaching impact",
      "type": "number"
    },
    "feedback_content": {
      "description": "Coaching guidance",
      "type": "string"
    },
    "feedback_title": {
      "description": "Short coaching title",
      "type": "string"
    },
    "rep_email": {
      "description": "Sales rep email",
      "type": "string"
    },
    "sentiment_context": {
      "description": "Current call sentiment",
      "enum": [
        "positive",
        "neutral",
        "negative"
      ],
      "type": "string"
    },
    "session_id": {
      "description": "Reference to ConversationSession",
      "type": "string"
    },
    "suggested_response": {
      "description": "What to say next",
      "type": "string"
    },
    "trigger_type": {
      "description": "What triggered the coaching",
      "enum": [
        "sentiment_shift",
        "objection_detected",
        "positive_signal",
        "silence",
        "closing_opportunity"
      ],
      "type": "string"
    },
    "urgency": {
      "description": "How important is this coaching",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "type": "string"
    }
  },
  "required": [
    "rep_email",
    "client_id",
    "trigger_type",
    "feedback_title",
    "feedback_content"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "data.rep_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.rep_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.rep_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}