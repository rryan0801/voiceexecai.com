{
  "name": "QuietPeriodAlert",
  "properties": {
    "alert_level": {
      "description": "How urgent is this silence",
      "enum": [
        "warning",
        "critical",
        "escalated"
      ],
      "type": "string"
    },
    "channels_silent": {
      "description": "Which channels have gone quiet",
      "items": {
        "enum": [
          "email",
          "sms",
          "linkedin",
          "call",
          "all"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "client_id": {
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "deal_stage_at_silence": {
      "description": "Where was deal when silence started",
      "type": "string"
    },
    "description": {
      "description": "Additional details or notes about this record",
      "maxLength": 1000,
      "type": "string"
    },
    "intervention_response": {
      "description": "Did prospect respond to intervention",
      "type": "string"
    },
    "intervention_triggered": {
      "default": false,
      "type": "boolean"
    },
    "intervention_type": {
      "enum": [
        "video_check_in",
        "manager_escalation",
        "multi_channel_blitz"
      ],
      "type": "string"
    },
    "last_activity": {
      "description": "What was the last interaction",
      "properties": {
        "channel": {
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "prospect_id": {
      "type": "string"
    },
    "prospect_name": {
      "type": "string"
    },
    "rep_email": {
      "type": "string"
    },
    "silence_duration_days": {
      "type": "number"
    },
    "silence_started_at": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "prospect_id",
    "client_id",
    "prospect_name",
    "silence_started_at"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "data.rep_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.rep_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.rep_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}