{
  "name": "OutreachCampaign",
  "properties": {
    "body": {
      "type": "string"
    },
    "converted_count": {
      "default": 0,
      "type": "number"
    },
    "delivered_count": {
      "default": 0,
      "type": "number"
    },
    "name": {
      "description": "Campaign name",
      "type": "string"
    },
    "open_count": {
      "default": 0,
      "type": "number"
    },
    "recipient_ids": {
      "description": "BuyerLead IDs",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "sent_at": {
      "format": "date-time",
      "type": "string"
    },
    "sent_by": {
      "type": "string"
    },
    "sent_count": {
      "default": 0,
      "type": "number"
    },
    "status": {
      "default": "draft",
      "enum": [
        "draft",
        "sent",
        "failed"
      ],
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "template_type": {
      "enum": [
        "welcome",
        "follow_up",
        "promo",
        "social_proof",
        "custom"
      ],
      "type": "string"
    }
  },
  "required": [
    "name",
    "template_type",
    "subject",
    "body"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}