{
  "name": "Website",
  "properties": {
    "competitors": {
      "description": "Competitor website URLs",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "description": {
      "description": "Additional details or notes about this record",
      "maxLength": 1000,
      "type": "string"
    },
    "google_analytics_connected": {
      "default": false,
      "type": "boolean"
    },
    "google_search_console_connected": {
      "default": false,
      "type": "boolean"
    },
    "industry": {
      "description": "Business industry",
      "type": "string"
    },
    "last_audit_date": {
      "format": "date-time",
      "type": "string"
    },
    "name": {
      "description": "Website name",
      "type": "string"
    },
    "seo_health_score": {
      "description": "Overall SEO score 0-100",
      "type": "number"
    },
    "status": {
      "default": "active",
      "enum": [
        "active",
        "paused",
        "error"
      ],
      "type": "string"
    },
    "target_keywords": {
      "description": "Primary keywords to target",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "url": {
      "description": "Website URL",
      "type": "string"
    },
    "user_id": {
      "description": "Owner user ID",
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "url",
    "name"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}