{
  "name": "ConversationSession",
  "properties": {
    "channel": {
      "description": "Communication channel",
      "enum": [
        "voice",
        "email",
        "chat",
        "sms",
        "whatsapp",
        "teams",
        "slack"
      ],
      "type": "string"
    },
    "client_id": {
      "description": "Client reference",
      "type": "string"
    },
    "conversation_flow": {
      "description": "Analysis of conversation progression",
      "properties": {
        "closing_sentiment": {
          "type": "string"
        },
        "conversation_depth": {
          "description": "Number of distinct topics covered",
          "type": "number"
        },
        "engagement_level": {
          "description": "0-100 engagement score",
          "type": "number"
        },
        "opening_sentiment": {
          "type": "string"
        },
        "rep_to_prospect_ratio": {
          "description": "Percentage of conversation from rep",
          "type": "number"
        },
        "sentiment_trajectory": {
          "enum": [
            "improving",
            "declining",
            "stable",
            "volatile"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "conversation_turns": {
      "description": "Multi-turn conversation history",
      "items": {
        "properties": {
          "intent": {
            "description": "Detected intent for this turn",
            "type": "string"
          },
          "key_topics": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "message": {
            "type": "string"
          },
          "sentiment": {
            "enum": [
              "positive",
              "neutral",
              "negative"
            ],
            "type": "string"
          },
          "speaker": {
            "enum": [
              "rep",
              "prospect",
              "system"
            ],
            "type": "string"
          },
          "timestamp": {
            "format": "date-time",
            "type": "string"
          },
          "turn_number": {
            "type": "number"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "description": {
      "description": "Additional details or notes about this record",
      "maxLength": 1000,
      "type": "string"
    },
    "ended_at": {
      "format": "date-time",
      "type": "string"
    },
    "extracted_context": {
      "description": "Key insights from full conversation",
      "properties": {
        "deal_signals": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "decision_timeline": {
          "description": "When prospect likely to decide",
          "type": "string"
        },
        "main_topics": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "next_steps": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "objections_raised": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "pain_points": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "prospect_id": {
      "description": "Prospect in conversation",
      "type": "string"
    },
    "prospect_name": {
      "type": "string"
    },
    "rep_email": {
      "description": "Sales rep email",
      "type": "string"
    },
    "session_status": {
      "default": "active",
      "enum": [
        "active",
        "paused",
        "closed"
      ],
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "type": "string"
    },
    "thread_metadata": {
      "description": "For conversation threading",
      "properties": {
        "parent_session_id": {
          "description": "Parent conversation if this is a follow-up",
          "type": "string"
        },
        "related_sessions": {
          "description": "IDs of related conversations",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "thread_tags": {
          "description": "Tags for organization",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "total_duration_seconds": {
      "description": "Total conversation duration",
      "type": "number"
    },
    "total_turns": {
      "default": 0,
      "type": "number"
    }
  },
  "required": [
    "client_id",
    "prospect_id",
    "channel"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "data.rep_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.rep_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.rep_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}