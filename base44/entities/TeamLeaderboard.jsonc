{
  "name": "TeamLeaderboard",
  "properties": {
    "avg_deal_velocity": {
      "description": "days to close",
      "type": "number"
    },
    "client_id": {
      "type": "string"
    },
    "coaching_effectiveness": {
      "description": "% of coaching applied",
      "type": "number"
    },
    "deals_won": {
      "type": "number"
    },
    "description": {
      "description": "Additional details or notes about this record",
      "maxLength": 1000,
      "type": "string"
    },
    "dna_strength": {
      "description": "0-100",
      "type": "number"
    },
    "period": {
      "default": "month",
      "enum": [
        "week",
        "month",
        "quarter"
      ],
      "type": "string"
    },
    "rank": {
      "type": "number"
    },
    "rep_email": {
      "type": "string"
    },
    "rep_name": {
      "type": "string"
    },
    "revenue_closed": {
      "type": "number"
    },
    "total_deals": {
      "type": "number"
    },
    "total_pipeline_value": {
      "type": "number"
    },
    "trend": {
      "enum": [
        "up",
        "down",
        "stable"
      ],
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "type": "string"
    },
    "weighted_expected": {
      "type": "number"
    },
    "win_rate": {
      "description": "%",
      "type": "number"
    }
  },
  "required": [
    "client_id",
    "rep_email",
    "rep_name",
    "period"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "data.rep_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.rep_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.rep_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}