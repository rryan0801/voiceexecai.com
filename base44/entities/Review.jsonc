{
  "name": "Review",
  "properties": {
    "ai_response": {
      "description": "AI-generated response suggestion",
      "type": "string"
    },
    "content": {
      "description": "Review text content",
      "type": "string"
    },
    "rating": {
      "description": "Rating out of 5",
      "type": "number"
    },
    "review_date": {
      "description": "Date the review was posted",
      "format": "date",
      "type": "string"
    },
    "reviewer_name": {
      "description": "Name of the person who left the review",
      "type": "string"
    },
    "sentiment": {
      "description": "AI-detected sentiment",
      "enum": [
        "positive",
        "neutral",
        "negative"
      ],
      "type": "string"
    },
    "source": {
      "description": "Platform where the review was posted",
      "enum": [
        "google",
        "yelp",
        "trustpilot",
        "facebook",
        "twitter",
        "reddit",
        "other"
      ],
      "type": "string"
    },
    "status": {
      "default": "new",
      "description": "Response status",
      "enum": [
        "new",
        "responded",
        "flagged",
        "archived"
      ],
      "type": "string"
    }
  },
  "required": [
    "reviewer_name",
    "content",
    "source"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}