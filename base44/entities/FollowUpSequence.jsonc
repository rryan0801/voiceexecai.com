{
  "name": "FollowUpSequence",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "completed_steps": {
      "default": 0,
      "type": "number"
    },
    "description": {
      "description": "Additional details or notes about this record",
      "maxLength": 1000,
      "type": "string"
    },
    "next_step_date": {
      "format": "date-time",
      "type": "string"
    },
    "prospect_email": {
      "type": "string"
    },
    "prospect_id": {
      "type": "string"
    },
    "prospect_name": {
      "type": "string"
    },
    "reply_detected": {
      "default": false,
      "type": "boolean"
    },
    "status": {
      "default": "active",
      "enum": [
        "active",
        "paused",
        "completed",
        "cancelled"
      ],
      "type": "string"
    },
    "steps": {
      "description": "Sequence of follow-up steps",
      "items": {
        "properties": {
          "action": {
            "enum": [
              "send_email",
              "create_task",
              "wait"
            ],
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "condition": {
            "default": "if_no_reply",
            "enum": [
              "always",
              "if_no_reply",
              "if_replied"
            ],
            "type": "string"
          },
          "delay_days": {
            "type": "number"
          },
          "executed_at": {
            "format": "date-time",
            "type": "string"
          },
          "status": {
            "default": "pending",
            "enum": [
              "pending",
              "executed",
              "skipped"
            ],
            "type": "string"
          },
          "step_number": {
            "type": "number"
          },
          "subject": {
            "type": "string"
          },
          "task_title": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "total_steps": {
      "default": 0,
      "type": "number"
    },
    "trigger_command_id": {
      "description": "The voice command that started this sequence",
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "prospect_id"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}