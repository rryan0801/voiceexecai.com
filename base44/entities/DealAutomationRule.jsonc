{
  "name": "DealAutomationRule",
  "properties": {
    "action_config": {
      "additionalProperties": true,
      "description": "Stage to move to, email template, etc.",
      "type": "object"
    },
    "action_type": {
      "enum": [
        "move_stage",
        "send_email",
        "create_task",
        "notify_manager"
      ],
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "deals_affected": {
      "default": 0,
      "type": "number"
    },
    "description": {
      "description": "Additional details or notes about this record",
      "maxLength": 1000,
      "type": "string"
    },
    "is_active": {
      "default": true,
      "type": "boolean"
    },
    "rule_name": {
      "type": "string"
    },
    "success_count": {
      "default": 0,
      "type": "number"
    },
    "trigger_type": {
      "enum": [
        "readiness_score",
        "objection_handled",
        "email_opened",
        "reply_detected",
        "meeting_booked"
      ],
      "type": "string"
    },
    "trigger_value": {
      "description": "e.g., readiness >= 80",
      "type": "number"
    }
  },
  "required": [
    "client_id",
    "rule_name",
    "trigger_type",
    "action_type"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}