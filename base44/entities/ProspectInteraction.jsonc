{
  "name": "ProspectInteraction",
  "properties": {
    "command_id": {
      "description": "Reference to Command entity",
      "type": "string"
    },
    "interaction_type": {
      "description": "Type of interaction",
      "enum": [
        "email",
        "call",
        "task",
        "meeting",
        "document",
        "other"
      ],
      "type": "string"
    },
    "prospect_id": {
      "description": "Reference to Prospect entity",
      "type": "string"
    },
    "result": {
      "additionalProperties": true,
      "description": "Result of the interaction",
      "type": "object"
    },
    "status": {
      "default": "completed",
      "description": "Interaction status",
      "enum": [
        "pending",
        "completed",
        "failed"
      ],
      "type": "string"
    },
    "summary": {
      "description": "Brief summary of what was done",
      "type": "string"
    }
  },
  "required": [
    "prospect_id",
    "command_id",
    "interaction_type",
    "summary"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}