{
  "name": "RepConversationDNA",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "closing_triggers": {
      "description": "What signals rep uses to close",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "deal_count_analyzed": {
      "description": "How many closed deals analyzed",
      "type": "number"
    },
    "description": {
      "description": "Additional details or notes about this record",
      "maxLength": 1000,
      "type": "string"
    },
    "dna_strength": {
      "description": "0-100 confidence in DNA signature",
      "type": "number"
    },
    "last_updated": {
      "format": "date-time",
      "type": "string"
    },
    "question_patterns": {
      "description": "Types of questions rep asks",
      "items": {
        "properties": {
          "frequency": {
            "type": "number"
          },
          "pattern": {
            "enum": [
              "discovery",
              "pain_point",
              "solution_fit",
              "budget",
              "timeline",
              "objection_handling"
            ],
            "type": "string"
          },
          "success_rate": {
            "type": "number"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "rep_email": {
      "type": "string"
    },
    "tone_signature": {
      "description": "Rep's natural communication style",
      "properties": {
        "confidence_level": {
          "description": "0-100",
          "type": "number"
        },
        "formality": {
          "enum": [
            "formal",
            "conversational",
            "casual"
          ],
          "type": "string"
        },
        "listening_ratio": {
          "description": "% of call rep lets prospect talk",
          "type": "number"
        },
        "urgency_creation": {
          "description": "How often they create urgency",
          "type": "number"
        }
      },
      "type": "object"
    },
    "winning_phrases": {
      "description": "Top phrases used in closed deals",
      "items": {
        "properties": {
          "close_rate_when_used": {
            "description": "% of deals using this that closed",
            "type": "number"
          },
          "phrase": {
            "type": "string"
          },
          "usage_count": {
            "type": "number"
          }
        },
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "rep_email",
    "client_id"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "data.rep_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.rep_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.rep_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}