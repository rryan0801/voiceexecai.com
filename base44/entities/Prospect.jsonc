{
  "name": "Prospect",
  "properties": {
    "client_id": {
      "description": "Reference to Client entity",
      "type": "string"
    },
    "company_name": {
      "description": "Company name",
      "type": "string"
    },
    "custom_fields": {
      "additionalProperties": true,
      "description": "Custom fields for extensibility",
      "type": "object"
    },
    "email": {
      "description": "Email address",
      "type": "string"
    },
    "interaction_count": {
      "default": 0,
      "description": "Total number of interactions",
      "type": "number"
    },
    "last_interaction_date": {
      "description": "Last interaction timestamp",
      "format": "date-time",
      "type": "string"
    },
    "notes": {
      "description": "Internal notes about prospect",
      "type": "string"
    },
    "phone": {
      "description": "Phone number",
      "type": "string"
    },
    "prospect_name": {
      "description": "Name of the prospect",
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "prospect_name",
    "company_name"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}